
# --- Targets ------------------------------------------------------------------------
# Hostnames, IPs and CIDR ranges that may be scanned (comma-separated).
ALLOWED_TARGETS=scanme.nmap.org,127.0.0.1,172.28.0.0/24
# DANGER: allow any target. Only on a private instance where you own every reachable host.
ALLOW_ANY_TARGET=false

# --- Scanning -----------------------------------------------------------------------
# true if nmap has raw-socket capability. The Docker image already sets this to true;
# only uncomment for a local (non-Docker) run where nmap is root or has cap_net_raw.
# NMAP_PRIVILEGED=false
SCAN_TIMEOUT_SECONDS=900
MAX_CONCURRENT_SCANS=2
# Replay a recorded scan instead of running nmap. Use this for a public demo.
DEMO_MODE=false

# --- Abuse protection ---------------------------------------------------------------
RATE_LIMIT_SCANS=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- CVE data -----------------------------------------------------------------------
# Free key: https://nvd.nist.gov/developers/request-an-api-key (raises the limit 10x)
NVD_API_KEY=
# Optional free key from vulners.com (https://vulners.com/userinfo): adds exploit status,
# KEV and EPSS data to findings. The Docker image installs vulners.nse 2.x, which reads it.
# Uncomment only when you have one (nmap reads it from the environment).
# VULNERS_API_KEY=

# --- AI explanations ----------------------------------------------------------------
# none | anthropic | openai | gemini | ollama
AI_PROVIDER=none
# Leave empty for the provider default (anthropic: claude-haiku-5-5, gemini: gemini-3.8-flash, ollama: llama3.1:8b).
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# From Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint works (Groq, LM Studio, vLLM, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
# From inside Docker, use http://host.docker.internal:11434 to reach Ollama on your machine.
OLLAMA_URL=http://localhost:11434

# --- Server -------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
